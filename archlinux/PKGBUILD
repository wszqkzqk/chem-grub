# Maintainer: Zhou Qiankang <wszqkzqk@qq.com>

pkgname=chem-grub
pkgver=0.0.0
pkgrel=1
pkgdesc='Chemistry-inspired GRUB2 theme with native localization and CJK support'
arch=('any')
url='https://github.com/wszqkzqk/chem-grub'
license=('GPL-2.0-or-later')
depends=('grub')
makedepends=('git' 'librsvg' 'make' 'python' 'python-fonttools' 'python-pillow')
source=("${pkgname}::git+file://${startdir}/..")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname}"
    git describe --tags --always --dirty --abbrev=12 | sed 's/^v//;s/-/./g'
}

build() {
    cd "${pkgname}"
    make
}

check() {
    cd "${pkgname}"
    make check
}

package() {
    cd "${pkgname}"
    make install DESTDIR="${pkgdir}"
}
